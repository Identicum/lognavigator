<?xml version="1.0" encoding="UTF-8" ?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
		version="3.0">

	<description>LogNavigator Tag Library</description>
	<display-name>LogNavigator</display-name>
	<tlib-version>1.0</tlib-version>
	<short-name>lognavigator</short-name>
	<uri>https://github.com/fbaligand/lognavigator/taglib</uri>

	<tag>
		<description>Write to JSP output, the raw content of executed command output</description>
		<name>rawContent</name>
		<tag-class>org.lognavigator.taglib.RawContentTag</tag-class>
		<body-content>empty</body-content>
	</tag>

</taglib>
